{{! templates/actors/character-details.hbs }}

<div class="tab details {{tab.cssClass}}"
     data-group="{{tab.group}}"
     data-tab="{{tab.id}}">

  <div class="abilities-skills">

    {{!-- ── STRENGTH ─────────────────────────────────────── --}}
    <div class="ability-group">
      <div class="ability-header">
        <a class="ability-name"
           data-action="abilityRoll"
           data-ability="str"
           title="Roll Strength check">
          <h3>{{localize "STORYFORM.AbilityStr"}}</h3>
        </a>
        <div class="ability-dc">
          <label>{{localize "STORYFORM.AbilityDC"}}</label>
          <input type="number" name="system.abilities.str.dc"
                 value="{{system.abilities.str.dc}}" min="8" max="20" />
        </div>
        <div class="skill-points-display {{#if isStrOver}}over-limit{{/if}}">
          <span>{{localize "STORYFORM.SkillPoints"}}:</span>
          <span class="points-spent">
            {{system.abilities.str.skillPointsSpent}}
          </span>
          / {{system.abilities.str.skillPoints}}
        </div>
      </div>
      <ul class="skill-list">
        <li class="skill-row">
          <a class="skill-roll" data-action="skillRoll" data-skill="brawling">
            <i class="fas fa-dice-d20"></i>
            <span class="skill-name">{{localize "STORYFORM.SkillBrawling"}}</span>
          </a>
          <div class="skill-dc">
            <label>DC</label>
            <input type="number" name="system.skills.brawling.dc"
                   value="{{system.skills.brawling.dc}}" min="8" max="30" />
          </div>
        </li>
        <li class="skill-row">
          <a class="skill-roll" data-action="skillRoll" data-skill="climb">
            <i class="fas fa-dice-d20"></i>
            <span class="skill-name">{{localize "STORYFORM.SkillClimb"}}</span>
          </a>
          <div class="skill-dc">
            <label>DC</label>
            <input type="number" name="system.skills.climb.dc"
                   value="{{system.skills.climb.dc}}" min="8" max="30" />
          </div>
        </li>
        <li class="skill-row">
          <a class="skill-roll" data-action="skillRoll" data-skill="intimidate">
            <i class="fas fa-dice-d20"></i>
            <span class="skill-name">{{localize "STORYFORM.SkillIntimidate"}}</span>
          </a>
          <div class="skill-dc">
            <label>DC</label>
            <input type="number" name="system.skills.intimidate.dc"
                   value="{{system.skills.intimidate.dc}}" min="8" max="30" />
          </div>
        </li>
        <li class="skill-row">
          <a class="skill-roll" data-action="skillRoll" data-skill="athletics">
            <i class="fas fa-dice-d20"></i>
            <span class="skill-name">{{localize "STORYFORM.SkillAthletics"}}</span>
          </a>
          <div class="skill-dc">
            <label>DC</label>
            <input type="number" name="system.skills.athletics.dc"
                   value="{{system.skills.athletics.dc}}" min="8" max="30" />
          </div>
        </li>
      </ul>
    </div>

