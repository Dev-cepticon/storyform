{{! templates/items/armor-sheet.hbs }}

<div class="storyform sheet item armor">

  {{!-- Header --}}
  <header class="item-header">
    <img class="item-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    <div class="item-header-fields">
      <input class="item-name" type="text" name="name" value="{{item.name}}" placeholder="Armor Name" />
      <div class="item-subtitle">
        <span class="item-type-label">Tier</span>
        <select name="system.tier">
          {{#each (numRange 1 5) as |n|}}
          <option value="{{n}}" {{#if (eq n ../system.tier)}}selected{{/if}}>
            {{n}}
          </option>
          {{/each}}
        </select>
      </div>
    </div>
  </header>

  {{!-- Body --}}
  <section class="item-body">

    {{!-- DR --}}
    <div class="form-group">
      <label>{{localize "STORYFORM.ArmorDR"}}</label>
      <div class="form-fields">
        <input type="number" name="system.dr" value="{{system.dr}}" min="0" max="10" />
        <span class="form-hint">
          Default for Tier {{system.tier}}: {{system.defaultDR}}
        </span>
      </div>
    </div>

    {{!-- Properties — free text, open-ended --}}
    <div class="form-group">
      <label>{{localize "STORYFORM.ArmorProperties"}}</label>
      <div class="array-list">
        {{#each system.properties as |prop i|}}
        <div class="array-row">
          <div class="named-block-header">
            <input type="text" name="system.properties.{{i}}.name" value="{{prop.name}}"
              placeholder="Property name..." />
          </div>
          <textarea name="system.properties.{{i}}.description"
            placeholder="Description or effect...">{{prop.description}}</textarea>
          <a class="array-delete" data-action="deleteProperty" data-index="{{i}}" title="Remove">
            <i class="fas fa-trash"></i>
          </a>
        </div>
        {{/each}}
        <button type="button" class="array-add" data-action="addProperty">
          <i class="fas fa-plus"></i> Add Property
        </button>
      </div>
    </div>

    {{!-- Description --}}
    <div class="form-group">
      <label>Description</label>
      <div class="prosemirror-wrapper">
        {{#if @root.editable}}
        {{!-- Remove the inner div; let prose-mirror use the value attribute --}}
        <prose-mirror name="system.description" value="{{system.description}}" toggled="true" collaborative="false">
          {{{enrichedDescription}}}
        </prose-mirror>
        {{else}}
        <div class="enriched-content editor-content">
          {{{enrichedDescription}}}
        </div>
        {{/if}}
      </div>
    </div>

  </section>

</div>