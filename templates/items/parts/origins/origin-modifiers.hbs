{{!--
Params:
@modList: system.skillModifiers or system.abilityModifiers
@choices: @root.skillChoices or @root.abilityChoices
@path: "system.skillModifiers"
@add: "addSkillMod"
@delete: "deleteSkillMod"
--}}
<div class="form-group">
  <label>{{localize label}}</label>
  <div class="">
    {{#if system.config.editMode}}

    {{#each modList as |mod i|}}
    <div class="bonus-display">
      {{!-- Force the path to exist for this index --}}
      <select name="{{../path}}.{{i}}.{{../typeKey}}">
        {{#each ../choices as |c|}}
        {{!-- Use c.key for the 'value' (what saves to the DB) --}}
        {{!-- Use c.label for the 'text' (what the user sees) --}}
        <option value="{{c.key}}" {{#if (eq c.key (lookup mod ../../typeKey))}}selected{{/if}}>
          {{c.label}}
        </option>
        {{/each}}
      </select>

      <input type="number" name="{{../path}}.{{i}}.modifier" value="{{mod.modifier}}" step="1" />

      <a class="array-delete" data-action="deleteModifier" data-path="{{../path}}" data-index="{{i}}">
        <i class="fas fa-trash"></i>
      </a>
    </div>
    {{/each}}
    <button type="button" class="array-add" data-action="addModifier" data-path="{{path}}" data-type-key="{{typeKey}}">
      <i class="fas fa-plus"></i> Add
    </button>
  </div>
  {{else}}
  {{!-- VIEW MODE: Clean Labels --}}
  <div class="bonus-display">
    {{#each modList as |mod|}}
    <span class="bonus-tag">
      {{!-- 1. The Value (e.g., +2) --}}
      <span class="modifier">{{#if (gt mod.modifier 0)}}+{{/if}}{{mod.modifier}}</span>

      {{!-- 2. The Label (Handles both Object and Array structures) --}}
      <span class="label">
        {{#each ../choices as |value key|}}
          {{!-- 
            Check if we are matching an Array of Objects (c.key) 
            or a standard Object key (key) 
          --}}
          {{#if (or (eq value.key (lookup mod ../../typeKey)) (eq key (lookup mod ../../typeKey)))}}
            {{!-- Localize the result: handles "Athletics" or "STORYFORM.SkillAthletics" --}}
            {{localize (ifThen value.label value.label value)}}
          {{/if}}
        {{/each}}
      </span>
    </span>
    {{else}}
    <span class="none-text">{{localize "STORYFORM.None"}}</span>
    {{/each}}
  </div>
  {{/if}}
</div>