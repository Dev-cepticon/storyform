


<div class="form-group">
  <label>{{localize "STORYFORM.RaceOncePerturn"}}</label>
  <div class="array-list">
    {{#each system.oncePerturn as |action i|}}
    <div class="named-block">
      <div class="header">
        <input type="text" name="system.oncePerturn.{{i}}.name" value="{{action.name}}" placeholder="Action name..." />
        <a 
        class="array-delete" 
        data-action="deleteAction" 
        data-index="{{i}}">
          <i class="fas fa-trash"></i>
        </a>
      </div>
      <textarea name="system.oncePerturn.{{i}}.description" placeholder="Description...">{{action.description}}</textarea>
    </div>
    {{/each}}
    <button 
    type="button" 
    class="array-add" 
    data-action="addAction">
      <i class="fas fa-plus"></i> Add
    </button>
  </div>
</div>