<div class="form-group">
  <label>{{localize "STORYFORM.RaceHeroDiceAbilities"}}</label>
  <div class="hero-dice-list">

    {{#if system.config.editMode}}
    {{#each system.heroDiceAbilities as |ability i|}}
    <div class="sf-card">
      <div class="sf-card-header">
        <input type="text" name="system.heroDiceAbilities.{{i}}.name" value="{{ability.name}}" placeholder="Name..." />
        <input type="number" name="system.heroDiceAbilities.{{i}}.cost" value="{{ability.cost}}" min="1" />
        <a 
        class="array-delete"
        data-action="deleteHDA" 
        data-index="{{i}}">
        <i class="fas fa-trash"></i>
        </a>
      </div>
      <textarea name="system.heroDiceAbilities.{{i}}.description">{{ability.description}}</textarea>
    </div>
    {{/each}}
    <button 
    type="button" 
    class="array-add" 
    data-action="addHDA">
    <i class="fas fa-plus"></i> Add
    </button>
  </div>
  {{else}}
  {{!-- VIEW MODE --}}
  <div class="hero-dice-list view-mode">
    {{#each system.heroDiceAbilities as |ability|}}
    <div class="sf-card">
      <div class="sf-card-header">
        {{!-- Ability Name --}}
        <span class="name">{{ability.name}}</span>
        
        {{!-- Ability Cost --}}
        <span class="sf-badge is-cost">
          <i class="fa-solid fa-dice-d6"></i> {{ability.cost}}
        </span>
      </div>
      
      {{!-- Description --}}
      <div class="description-text">
        {{ability.description}}
      </div>
    </div>
    {{else}}
    <span class="none-text">{{localize "STORYFORM.None"}}</span>
    {{/each}}
  </div>
  {{/if}}
</div>