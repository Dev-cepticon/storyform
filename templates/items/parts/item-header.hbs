<header class="sf-sheet-header-wrapper sf-banner-art">
  {{!-- New Top Row for Global Actions --}}
  <div class="sf-header-content">
    <div class="header-top-left">
      <div class="sf-switch">
        <label class="sf-slider">
          <input type="checkbox" name="system.config.editMode" {{checked system.config.editMode}}>
          <span class="slider round">
            <span class="thumb">
              <i class="fas fa-wrench"></i>
            </span>
          </span>
        </label>
      </div>
    </div>
    <div class="header-top-right">
      {{#if system.config.editMode}}
      {{!-- The "active" class is applied only when the sidebar is open --}}
      <a class="config-button {{#if system.config.showSidebar}}active{{/if}}" data-action="config"
        title="Configure Item">
        <i class="fas fa-cog"></i>
      </a>
      {{/if}}
    </div>
  </div>

  {{!-- Existing Header Content --}}
  <div class="sf-header-content">

    <div class="header-left">

      <img class="profile-img" src="{{item.img}}" {{#if system.config.editMode}} data-action="editImage" data-edit="img"
        title="Change Image" {{/if}} />
    </div>

    <div class="header-center">
      {{#if system.config.editMode}}
      <input class="item-name" type="text" name="name" value="{{item.name}}" />
      {{else}}
      <div class="item-name">{{item.name}}</div>
      {{/if}}
      <div class="item-type">{{item.type}}</div>
    </div>
  </div>
  <div class="header-right">
    {{! placeholder}}
  </div>

</header>