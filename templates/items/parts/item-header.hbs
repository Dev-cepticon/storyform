<header class="item-header-v2">
  {{!-- New Top Row for Global Actions --}}
  <div class="header-top">
    <div class="header-top-left">
      <div class="edit-mode-slider">
        <label class="switch">
          <input type="checkbox" name="system.config.editMode" {{checked system.config.editMode}}>
          <span class="slider round">
            <span class="thumb">
              <i class="fas fa-wrench"></i>
            </span>
          </span>
        </label>
      </div>
    </div>
    <div class="header-top-right">
      {{#if system.config.editMode}}
      <a class="config-button" data-action="config" title="Configure Item">
        <i class="fas fa-cog"></i>
      </a>
      {{/if}}
    </div>
  </div>

  {{!-- Existing Header Content --}}
  <div class="header-main">

    <div class="header-left">

      <img class="item-img" src="{{item.img}}" 
           {{#if system.config.editMode}}
             data-action="editImage" 
             data-edit="img"
             title="Change Image"
           {{/if}} />
    </div>

    <div class="header-center">
      {{#if system.config.editMode}}
      <input class="item-name" 
        type="text" 
        name="name" 
        value="{{item.name}}" />
      {{else}}
      <div class="item-name">{{item.name}}</div>
      {{/if}}
      <div class="item-type">{{item.type}}</div>
    </div>
  </div>
  <div class="header-right">
    {{! placeholder}}
  </div>

</header>

