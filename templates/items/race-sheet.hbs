{{! templates/items/race-sheet.hbs }}

<div class="storyform sheet item race">

  {{!-- Header --}}
  <header class="item-header">
    <img class="item-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    <div class="item-header-fields">
      <input class="item-name" type="text" name="name" value="{{item.name}}" placeholder="Race Name" />
      <div class="item-subtitle">
        <select name="system.size">
          <option value="tiny" {{#if (eq system.size "tiny" )}}selected{{/if}}>Tiny</option>
          <option value="small" {{#if (eq system.size "small" )}}selected{{/if}}>Small</option>
          <option value="medium" {{#if (eq system.size "medium" )}}selected{{/if}}>Medium</option>
          <option value="large" {{#if (eq system.size "large" )}}selected{{/if}}>Large</option>
          <option value="huge" {{#if (eq system.size "huge" )}}selected{{/if}}>Huge</option>
        </select>
      </div>
    </div>
  </header>

  {{!-- Body --}}
  <section class="item-body">

    {{!-- Age --}}
    <div class="form-group">
      <label>Age</label>
      <div class="form-fields inline-pair">
        <label class="inline-label">Maturity</label>
        <input type="number" name="system.age.maturity" value="{{system.age.maturity}}" min="0" />
        <label class="inline-label">Max</label>
        <input type="number" name="system.age.max" value="{{system.age.max}}" min="1" />
      </div>
    </div>
    {{!-- HP Bonus --}}
    <div class="form-group">
      <label>{{localize "STORYFORM.RaceHpBonus"}}</label>
      <div class="form-fields">
        <input type="number" name="system.hpBonus" value="{{system.hpBonus}}" />
        <span class="form-hint">Added to base HP of 15</span>
      </div>
    </div>

    {{!-- Movement --}}
    <div class="form-group">
      <label>{{localize "STORYFORM.AttributeMovement"}}</label>
      <div class="form-fields">
        <input type="number" name="system.movement" value="{{system.movement}}" min="1" />
        <span class="form-hint">squares per turn</span>
      </div>
    </div>
    {{!-- Racial Trait --}}
    <div class="form-group">
      <label>Racial Trait</label>
      <div class="named-block">
        <label class="checkbox-label">
          <input type="checkbox" name="system.racialTrait.hasTrait" {{#if system.racialTrait.hasTrait}}checked{{/if}} />
          Has Racial Trait
        </label>
        {{#if system.racialTrait.hasTrait}}
        <input type="text" name="system.racialTrait.name" value="{{system.racialTrait.name}}"
          placeholder="Trait name..." />
        <textarea name="system.racialTrait.description"
          placeholder="Trait description...">{{system.racialTrait.description}}</textarea>
        {{/if}}
      </div>
    </div>

    <div>
      {{!-- 1. Ability Modifiers (Required for Race) --}}
      {{> "systems/storyform/templates/items/parts/origins/origin-modifiers.hbs"
      label="Ability Modifiers" modList=system.abilityModifiers choices=@root.abilityChoices
      path="system.abilityModifiers" typeKey="ability" add="addAbilityMod" delete="deleteAbilityMod"}}

      <div class="toggle-section">
        {{!-- 2. Optional Skill Modifiers --}}
        <div class="toggle-section">
          <label><input type="checkbox" name="system.config.hasSkills" {{checked system.config.hasSkills}}> Add Skill
            Mods?</label>
          {{#if system.config.hasSkills}}
          {{> "systems/storyform/templates/items/parts/origins/origin-modifiers.hbs"
          label="Skill Modifiers" modList=system.skillModifiers choices=@root.skillChoices
          path="system.skillModifiers" typeKey="skill" add="addSkillMod" delete="deleteSkillMod"}}
          {{/if}}
        </div>

        {{!-- Optional Once-Per-Turn Actions --}}
        <div class="toggle-section">
          <label>
            <input type="checkbox" name="system.config.hasAction" {{checked system.config.hasAction}}>
            Add Skill Once Per Turn?
          </label>
          {{#if system.config.hasAction}}
          {{> "systems/storyform/templates/items/parts/origins/origin-actions.hbs"}}
          {{/if}}
        </div>

        {{!-- 3. Optional Hero Dice --}}
        <div class="toggle-section">
          <label><input type="checkbox" name="system.config.hasHeroDice" {{checked system.config.hasHeroDice}}> Add Hero
            Dice?</label>
          {{#if system.config.hasHeroDice}}
          {{> "systems/storyform/templates/items/parts/origins/origin-herodice.hbs"}}
          {{/if}}
        </div>
      </div>

      {{!-- Description --}}
      <div class="form-group">
        <label>Description</label>
        <div class="prosemirror-wrapper">
          {{#if @root.editable}}
          {{!-- Remove the inner div; let prose-mirror use the value attribute --}}
          <prose-mirror name="system.description" value="{{system.description}}" toggled="true" collaborative="false"">
          {{{enrichedDescription}}}
        </prose-mirror>
        {{else}}
        <div class=" enriched-content editor-content">
            {{{enrichedDescription}}}
        </div>
        {{/if}}
      </div>
    </div>

  </section>

</div>