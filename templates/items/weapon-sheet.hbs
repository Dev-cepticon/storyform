{{! templates/items/weapon-sheet.hbs }}
<form class="storyform sheet item weapon" autocomplete="off">

  {{!-- Header --}}
  <header class="item-header">
    <img class="item-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    <div class="item-header-fields">
      {{!-- Ensure name has a proper name attribute --}}
      <input class="item-name" type="text" name="name" value="{{item.name}}" placeholder="Weapon Name" />
      
      <div class="item-subtitle">
        <select name="system.category">
          <option value="melee" {{#if (eq system.category "melee" )}}selected{{/if}}>Melee</option>
          <option value="gun" {{#if (eq system.category "gun" )}}selected{{/if}}>Gun</option>
        </select>

        <span class="item-type-label">— Tier</span>
        <select name="system.tier">
          {{#each (numRange 1 5) as |n|}}
          <option value="{{n}}" {{#if (eq n ../system.tier)}}selected{{/if}}>{{n}}</option>
          {{/each}}
        </select>
      </div>
    </div>
  </header>

  {{!-- Body --}}
  <section class="item-body">

    <div class="form-group">
      <label>{{localize "STORYFORM.WeaponDamage"}}</label>
      <div class="form-fields">
        <input type="text" name="system.damage" value="{{system.damage}}" placeholder="{{system.defaultDamage}}" />
      </div>
    </div>

    <div class="form-group">
      <label>{{localize "STORYFORM.WeaponProperties"}}</label>
      <div class="array-list">
        {{#each system.properties as |prop i|}}
        <div class="array-row">
          <input type="text" name="system.properties.{{i}}" value="{{prop}}" />
          <a class="array-delete" data-action="deleteProperty" data-index="{{i}}"><i class="fas fa-trash"></i></a>
        </div>
        {{/each}}
        <button type="button" data-action="addProperty">Add Property</button>
      </div>
    </div>

    <div class="form-group">
      <label>Description</label>
      <div class="prosemirror-wrapper">
        {{#if @root.editable}}
          <prose-mirror name="system.description" value="{{system.description}}" toggled="true">
            {{{enrichedDescription}}}
          </prose-mirror>
        {{else}}
          <div class="enriched-content">{{{enrichedDescription}}}</div>
        {{/if}}
      </div>
    </div>

  </section> {{!-- END OF ITEM-BODY --}}
</form> {{!-- END OF FORM --}}