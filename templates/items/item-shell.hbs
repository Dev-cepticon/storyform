<div class="storyform sheet item">

  {{!-- 1. Global Header --}}
  {{> "systems/storyform/templates/items/parts/item-header.hbs"}}

  {{!-- 2. Navigation --}}
  {{> "systems/storyform/templates/items/parts/item-tabs.hbs"}}

  <section class="item-body-layout">
    {{!-- 3. Slide-out Sidebar (Config) --}}
    <aside class="sf-sheet-sidebar-drawer {{#if system.config.editMode}}{{#if system.config.showSidebar}}is-active{{/if}}{{/if}}">
      <div class="drawer-content">
        <h3><i class="fa-solid fa-gears"></i> {{localize "STORYFORM.Config.Config"}}</h3>
        {{> (lookup . 'sidebarTemplate')}}
      </div>
    </aside>

    {{!-- 4. Main Body Content --}}
    <main class="item-main-content">
      {{> (lookup . 'mainTemplate')}}
    </main>
  </section>
</div>