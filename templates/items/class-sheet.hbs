{{! templates/items/class-sheet.hbs }}

<div class="storyform sheet item class">

  {{!-- Header --}}
  <header class="item-header">
    <img class="item-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    <div class="item-header-fields">
      <input class="item-name" type="text" name="name" value="{{item.name}}" placeholder="Class Name" />
      <input class="item-role" type="text" name="system.role" value="{{system.role}}"
        placeholder="Role description..." />
    </div>
  </header>

  {{!-- Body --}}
  <section class="item-body">

    {{!-- Skill Modifiers--}}
    <div class="form-group">
      <label>{{localize "STORYFORM.RaceSkillModifiers"}}</label>
      <div class="array-list">
        {{#each system.skillModifiers as |mod i|}}
        <div class="array-row">
          <select name="system.skillModifiers.{{i}}.skill">
            {{#each @root.skillChoices as |choice|}}
            <option value="{{choice.key}}" {{#if (eq mod.skill choice.key)}}selected{{/if}}>
              {{choice.label}}
            </option>
            {{/each}}
          </select>

          <input type="number" name="system.skillModifiers.{{i}}.modifier" value="{{mod.modifier}}" step="1"
            data-dtype="Number" />

          {{!-- Action changed to deleteSkillMod --}}
          <a class="array-delete" data-action="deleteSkillMod" data-index="{{i}}" title="Remove">
            <i class="fas fa-trash"></i>
          </a>
        </div>
        {{/each}}

        {{!-- Action changed to addSkillMod --}}
        <button type="button" class="array-add" data-action="addSkillMod">
          <i class="fas fa-plus"></i> Add Skill Modifier
        </button>
      </div>
    </div>

    {{!-- Once Per Turn --}}
    <div class="form-group">
      <label>Once Per Turn</label>
      <div class="named-block">
        <input type="text" name="system.oncePerturn.name" value="{{system.oncePerturn.name}}"
          placeholder="Ability name..." />
        <textarea name="system.oncePerturn.description"
          placeholder="Description...">{{system.oncePerturn.description}}</textarea>
      </div>
    </div>

    {{!-- Hero Dice Abilities --}}
    <div class="form-group">
      <label>{{localize "STORYFORM.ClassHeroDiceAbilities"}}</label>
      <div class="array-list">
        {{#each system.heroDiceAbilities as |ability i|}}
        <div class="array-row named-block">
          <div class="named-block-header">
            <input type="text" name="system.heroDiceAbilities.{{i}}.name" value="{{ability.name}}"
              placeholder="Ability name..." />
            <label class="inline-label">Cost</label>
            <input type="number" name="system.heroDiceAbilities.{{i}}.cost" value="{{ability.cost}}" min="1" />
            <a class="array-delete hda-delete" data-index="{{i}}" title="Remove" data-action="deleteHDA">
              <i class="fas fa-trash"></i>
            </a>
          </div>
          <textarea name="system.heroDiceAbilities.{{i}}.description"
            placeholder="Description...">{{ability.description}}</textarea>
        </div>
        {{/each}}
        <button type="button" class="hda-add array-add" data-action="addHDA">
          <i class="fas fa-plus"></i> Add Hero Dice Ability
        </button>
      </div>
    </div>

    {{!-- Description --}}
    <div class="form-group">
      <label>Description</label>
      <div class="prosemirror-wrapper">
        {{#if @root.editable}}
        {{!-- Remove the inner div; let prose-mirror use the value attribute --}}
        <prose-mirror name="system.description" value="{{system.description}}" toggled="true" collaborative="false"">
          {{{enrichedDescription}}}
        </prose-mirror>
        {{else}}
        <div class=" enriched-content editor-content">
          {{{enrichedDescription}}}
      </div>
      {{/if}}
    </div>

  </section>

</div>